  push r8
  push r9
  push r10
  push r11
  sub rsp, 20
  mov ecx, edi
  call TT2EOS-Win64-Shipping.exe+20EFC10
  add rsp, 20
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  cmp al, 1
  je TT2EOS-Win64-Shipping.exe+20DA32B
  test r14b, r14b
  jne TT2EOS-Win64-Shipping.exe+20D9FDE
  jmp returnhere

TT2EOS-Win64-Shipping.exe+20D9FA8:
  jmp newmem
returnhere:

[DISABLE]
TT2EOS-Win64-Shipping.exe+20D9FA8:
  db 45 84 F6 75 31
dealloc(newmem)
