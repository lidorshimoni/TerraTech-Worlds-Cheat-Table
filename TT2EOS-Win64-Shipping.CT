    <CheatEntry>
      <ID>30</ID>
      <Description>"Fast Shooting (Rapid Fire)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(tt2_rapid_hook, 256)
alloc(tt2_rapid_orig, 32)
registersymbol(tt2_rapid_orig)

tt2_rapid_orig:
  readmem(TT2EOS-Win64-Shipping.exe+201DE4B, 17)

tt2_rapid_hook:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  sub rsp,38
  vmovss [rsp+20],xmm0

  mov rax,[rbp+20]
  mov ecx,[rax+r15*4]
  call TT2EOS-Win64-Shipping.exe+20EFC10
  cmp al,1

  vmovss xmm0,[rsp+20]
  lea rsp,[rsp+38]
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax

  je tt2_rapid_skip
  vmovss [rdi+4C],xmm0
tt2_rapid_skip:
  vmovss xmm0,[rax+00000094]
  vcomiss xmm0,xmm6
  jmp TT2EOS-Win64-Shipping.exe+201DE5C

TT2EOS-Win64-Shipping.exe+201DE4B:
  db FF 25 00 00 00 00
  dq tt2_rapid_hook
  db 90 90 90

[DISABLE]
TT2EOS-Win64-Shipping.exe+201DE4B:
  readmem(tt2_rapid_orig, 17)

unregistersymbol(tt2_rapid_orig)
dealloc(tt2_rapid_hook)
dealloc(tt2_rapid_orig)
</AssemblerScript>
