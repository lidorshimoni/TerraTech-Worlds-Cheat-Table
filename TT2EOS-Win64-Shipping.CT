<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>10</ID>
      <Description>"God Mode &amp; Unlimited Consumables (Auto-Keep-Alive)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
if _tt2GodTimer then _tt2GodTimer.destroy() end
_tt2GodTimer = createTimer(nil)
_tt2GodTimer.Interval = 300
_tt2GodTimer.OnTimer = function()
  local gw = readQword("TT2EOS-Win64-Shipping.exe+743E688")
  if not gw or gw &lt; 0x10000 then return end
  local gi = readQword(gw + 0x1B8)
  local lps = gi and readQword(gi + 0x38)
  local lp0 = lps and readQword(lps)
  local pc = lp0 and readQword(lp0 + 0x30)
  local ps = pc and readQword(pc + 0x298)
  if not ps or ps &lt; 0x10000 then return end
  local entHandle = readInteger(ps + 0x3AC)
  local regPtr = readQword("TT2EOS-Win64-Shipping.exe+719C1A8")
  local reg = regPtr and readQword(regPtr)
  local compBase = readQword("TT2EOS-Win64-Shipping.exe+719C1F8")
  if not reg or not compBase then return end

  local function getComp(handle, poolRva)
    local slot = reg + (handle &amp; 0xFFFFFF) * 12
    local pool = readQword("TT2EOS-Win64-Shipping.exe+" .. poolRva)
    if not pool or pool &lt; 0x10000 then return 0 end
    local r10 = readInteger(slot + 4, true)
    local r11 = readQword(pool + 0x28)
    local r8 = readInteger(r11 + (r10 &gt;&gt; 7) * 4, true)
    local cur = slot
    local guard = 0
    while readInteger(cur + 8) ~= 0 and guard &lt; 16 do
      guard = guard + 1
      local nextSlot = reg + (readInteger(cur + 8) &amp; 0xFFFFFF) * 12
      local r9 = readInteger(nextSlot + 4, true)
      local edx = readInteger(r11 + (r9 &gt;&gt; 7) * 4, true)
      if r8 == -1 and edx ~= -1 then r8 = edx; r10 = r9 end
      cur = nextSlot
    end
    if r8 == -1 then return 0 end
    local elemSize = readInteger(pool + 0x0C, true)
    return compBase + (r10 &amp; 0x7F) * elemSize + r8
  end

  local comp1 = getComp(entHandle, "719DA08")
  if comp1 and comp1 &gt; 0x10000 then
    local ent2 = readInteger(comp1 + 4)
    local comp2 = getComp(ent2, "71A36C8")
    if comp2 and comp2 &gt; 0x10000 then
      writeBytes(comp2 + 0xC1, 1)
      writeBytes(comp2 + 0xC2, 1)
    end
  end
end
_tt2GodTimer.OnTimer()

[DISABLE]
if _tt2GodTimer then
  _tt2GodTimer.destroy()
  _tt2GodTimer = nil
end
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>14</ID>
