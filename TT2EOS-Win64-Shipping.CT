</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>39</ID>
      <Description>"Unlimited Money (99,999,999)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if _tt2MoneyTimer then _tt2MoneyTimer.destroy() _tt2MoneyTimer = nil end

local function getComp(base, e, poolOff)
  if not e or e == 0 then return nil end
  local idx = e &amp; 0xFFFFFF
  local reg = readQword(base + 0x719C1A8)
  if not reg or reg == 0 then return nil end
  local entBase = readQword(reg)
  if not entBase or entBase == 0 then return nil end
  local entSlot = entBase + idx * 12
  local alive = readSmallInteger(entSlot)
  if not alive or alive == 0 then return nil end
  if readBytes(entSlot + 3, 1) ~= ((e &gt;&gt; 24) &amp; 0xFF) then return nil end
  local pool = readQword(base + poolOff)
  if not pool or pool == 0 then return nil end
  local r11 = readQword(pool + 0x28)
  local stride = readInteger(pool + 0x0C)
  local compBase = readQword(base + 0x719C1F8)
  if not r11 or not stride or not compBase then return nil end
  local r10 = readInteger(entSlot + 4)
  local r8 = readInteger(r11 + (r10 &gt;&gt; 7) * 4)
  while true do
    if r8 ~= -1 and r8 ~= 0xFFFFFFFF then
      return compBase + (r8 &amp; 0xFFFFFFFF) + (r10 &amp; 0x7F) * stride
    end
    local nextEnt = readInteger(entSlot + 8)
    if not nextEnt or nextEnt == 0 then return nil end
    entSlot = entBase + (nextEnt &amp; 0xFFFFFF) * 12
    r10 = readInteger(entSlot + 4)
    r8 = readInteger(r11 + (r10 &gt;&gt; 7) * 4)
  end
end

local function applyMoney()
  local base = getAddress("TT2EOS-Win64-Shipping.exe")
  if not base or base == 0 then return end
  local gw = readQword(base + 0x743E688)
  if not gw or gw == 0 then return end
  local gi = readQword(gw + 0x1B8)
  if not gi or gi == 0 then return end
  local lpArr = readQword(gi + 0x38)
  if not lpArr or lpArr == 0 then return end
  local lp = readQword(lpArr)
  if not lp or lp == 0 then return end
  local pc = readQword(lp + 0x30)
  if not pc or pc == 0 then return end
  local ps = readQword(pc + 0x298)
  if not ps or ps == 0 then return end
  local ent = readInteger(ps + 0x3AC)
  local comp1 = getComp(base, ent, 0x71A7780)
  if not comp1 then return end
  local curEnt = readInteger(comp1 + 4)
  local comp2 = getComp(base, curEnt, 0x71A7CE0)
  if not comp2 then return end
  local amtOff = readInteger(comp2 + 0x0C)
  local amtCnt = readInteger(comp2 + 0x10)
  local compBase = readQword(base + 0x719C1F8)
  if not amtOff or not amtCnt or amtCnt &lt;= 0 or amtCnt &gt; 32 or not compBase then return end
  for i = 0, amtCnt - 1 do
    local addr = compBase + amtOff + i * 4
    local cur = readInteger(addr)
    if cur and cur &lt; 99999999 then
      writeInteger(addr, 99999999)
    end
  end
end

_tt2MoneyTimer = createTimer(nil)
_tt2MoneyTimer.Interval = 500
_tt2MoneyTimer.OnTimer = applyMoney
applyMoney()
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if _tt2MoneyTimer then _tt2MoneyTimer.destroy() _tt2MoneyTimer = nil end
{$asm}
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>41</ID>
      <Description>"Fill Techyard With All Blocks (50 Each) [One-Shot]"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local base = getAddress("TT2EOS-Win64-Shipping.exe")
if not base or base == 0 then return end
local gw = readQword(base + 0x743E688)
local gi = gw and readQword(gw + 0x1B8)
local eng = gi and readQword(gi + 0x20)
local lp = gi and readQword(readQword(gi + 0x38))
local pc = lp and readQword(lp + 0x30)
if not eng or not pc or eng == 0 or pc == 0 then return end

local vt = readQword(eng)
local slot = vt + 0x2F0
local orig = readQword(slot)
local mem = allocateMemory(1024)
local data = mem + 0x200
writeInteger(data + 0x00, 0)
writeQword(data + 0x08, slot)
writeQword(data + 0x10, orig)
writeQword(data + 0x18, pc)
writeQword(data + 0x20, base + 0x205D810)
writeQword(data + 0x30, 0)
writeQword(data + 0x38, 0)

autoAssemble(string.format([[
0x%X:
  mov al,1
  xchg [0x%X],al
  test al,al
  jnz skip_exec
  push rax
  push rcx
  push rdx
  push r8
  push r9
  push r10
  push r11
  push rbx
  sub rsp,28
  mov rax,[0x%X]
  mov rbx,[0x%X]
  mov [rbx],rax
  mov rcx,[0x%X]
  mov edx,50
  mov r8,0x%X
  xor r9d,r9d
  call qword ptr [0x%X]
  add rsp,28
  pop rbx
  pop r11
  pop r10
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax
skip_exec:
  jmp qword ptr [0x%X]
]], mem, data, data + 0x10, data + 0x08, data + 0x18, data + 0x30, data + 0x20, data + 0x10))

fullAccess(slot, 8)
writeQword(slot, mem)
for i = 1, 20 do sleep(50) if readBytes(data, 1) == 1 then break end end
writeQword(slot, orig)
sleep(50)
deAlloc(mem)

local t = createTimer(nil)
t.Interval = 100
t.OnTimer = function(tm)
  tm.destroy()
  memrec.Active = false
end
{$asm}

[DISABLE]
</AssemblerScript>
    </CheatEntry>
