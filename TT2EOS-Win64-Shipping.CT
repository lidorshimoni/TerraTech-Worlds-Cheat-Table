    <CheatEntry>
      <ID>31</ID>
      <Description>"Maximize All Cargo Stacks (9999)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local base = getAddress("TT2EOS-Win64-Shipping.exe")
local regPtr = readQword(base + 0x719C1A8)
local compBase = readQword(base + 0x719C1F8)
local gridPool = readQword(base + 0x71A7268)
if regPtr and compBase and gridPool and gridPool ~= 0 then
  local regBase = readQword(regPtr)
  local function getComp(ent, poolPtrAddr)
    local pool = readQword(poolPtrAddr)
    if not pool or pool == 0 then return nil end
    local idx = ent &amp; 0xFFFFFF
    local slot = readInteger(regBase + idx * 12 + 4)
    if not slot or slot &lt; 0 then return nil end
    local page = math.floor(slot / 128)
    local sparse = readQword(pool + 0x28)
    local pageOff = readInteger(sparse + page * 4)
    if not pageOff or pageOff == -1 or pageOff == 0xFFFFFFFF then return nil end
    local stride = readInteger(pool + 0x0C)
    return compBase + pageOff + (slot % 128) * stride
  end
  local sparse = readQword(gridPool + 0x28)
  for page = 0, 1000 do
    local pageOff = readInteger(sparse + page * 4)
    if pageOff and pageOff ~= -1 and pageOff ~= 0xFFFFFFFF then
      local a = compBase + pageOff
      for s = 0, 127 do
        local g = a + s * 24
        local w = readBytes(g + 0x00, 1)
        local h = readBytes(g + 0x01, 1)
        local arrOff = readInteger(g + 0x04)
        local cap = readInteger(g + 0x08)
        local used = readInteger(g + 0x0C)
        if w and w &gt; 0 and w &lt;= 16 and h and h &gt; 0 and cap and cap &gt; 0 and cap &lt; 1000 and used and used &lt;= cap then
          for j = 0, used - 1 do
            local itemEnt = readInteger(compBase + arrOff + j * 4)
            local ic = getComp(itemEnt, base + 0x71A71D8)
            if ic then writeInteger(ic + 0x04, 9999) end
          end
        end
      end
    end
  end
end
{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
